# URL de tu API FastAPI (sin trailing slash)
# En local con Docker: http://localhost:8000
# En producción: https://tu-api.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# Gmail SMTP para el formulario de contacto (app/api/contact/route.ts)
# GMAIL_USER: cuenta de Gmail remitente
# GMAIL_APP_PASSWORD: contraseña de aplicación generada en https://myaccount.google.com/apppasswords
# (no uses la contraseña normal de la cuenta, Gmail la rechaza para SMTP)
GMAIL_USER=tu-email@gmail.com
GMAIL_APP_PASSWORD=tu-app-password
