# URL de tu API FastAPI (sin trailing slash)
# En local con Docker: http://localhost:8000
# En producción: https://tu-api.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# Resend para el formulario de contacto (app/api/contact/route.ts)
# RESEND_API_KEY: API key generada en https://resend.com/api-keys
# RESEND_FROM_EMAIL: remitente verificado en Resend, ej. "VIP Booster <noreply@kythos.vip>"
#   (mientras no verifiques un dominio propio, puedes dejar el default de pruebas
#   "VIP Booster <onboarding@resend.dev>" que usa el código si no se define esta variable)
RESEND_API_KEY=tu-resend-api-key
RESEND_FROM_EMAIL=VIP Booster <onboarding@resend.dev>
